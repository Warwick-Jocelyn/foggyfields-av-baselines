+# NVIDIA_AV_Fog config — RGB-only EmerNeRF (matches pandaset.yaml shape)
+# Inherits structure from default_config.yaml; only the keys we override are listed here.
+
+data:
+  data_root: /networkhome/WMGDS/wang3_y/ETH/Dataset/NVIDIA_AV_Fog
+  dataset: nvidia_av_fog            # routes to NVIDIAAVFogDataset in train_emernerf.py
+  scene_idx: "002"                  # str prefix; clip dir resolved by glob match (002_*)
+  start_timestep: 0
+  end_timestep: -1                  # -1 → use full clip (199 frames @ 10 Hz ≈ 19.9 s)
+  ray_batch_size: 8192
+  preload_device: cuda
+  pixel_source:
+    load_size: [960, 1280]          # uniform resize for all 7 heterogeneous cams
+                                    # (native: 3x 1280x960, 2x 1120x800, 2x 480x320)
+    downscale: 1
+    num_cams: 7                     # rear_left, FL, F, FR, rear_right, front_tele, rear_tele
+    test_image_stride: 2            # NVS-50/50 style (every other frame to val)
