+# (the paper's headline configuration; matches SplatAD's 6-camera observation budget)
+# Inherits structure from default_config.yaml; only the keys we override are listed here
+# (full keys are still pulled from default_config.yaml at CLI time via --config_file).
+
+data:
+  data_root: /networkhome/WMGDS/wang3_y/ETH/Code/SplatAD/dataset
+  dataset: pandaset                # routes to PandaSetDataset in train_emernerf.py
