+class RollingShutterLookup:
+    """Per-sensor table of per-pixel readout times, in seconds, relative to the image
+    timestamp.
+
+    Rolling-shutter time is normally modelled as linear in the output row:
+    ``(row / height - 0.5) * rolling_shutter_time``. That holds for a raw sensor, but not
+    for an image that has been RESAMPLED -- after a fisheye-to-pinhole rectification one
+    output row is a curve across many source rows, so its readout time also varies along
+    the row. A dataparser can supply the real mapping here; it then replaces the
+    row-linear formula.
+
+    One table per sensor index (``Cameras.metadata["sensor_idxs"]``), shared by every
+    frame of that camera. Each table is stored on a strided sub-grid of the UNCROPPED
+    canvas:
+
+        table[y, x] = t at canvas pixel (stride * y, stride * x)
+
+    so sampling is bilinear in canvas-index space with a replicated border -- equivalent
+    to ``cv2.remap(table, col/stride, row/stride, INTER_LINEAR, BORDER_REPLICATE)``, i.e.
+    to upsampling the table at load and indexing it. ``offsets`` is the (x, y) of the crop
+    applied to the delivered image, so a cropped pixel maps back onto the canvas.
+
+    This is deliberately NOT a tensor field: TensorDataclass would try to broadcast it to
+    the camera batch shape. ``__deepcopy__`` returns self because the tables are
+    read-only, which keeps the per-call copy in ``_apply_fn_to_dict`` free.
+    """
+
+    def __init__(
+        self,
+        tables: Dict[int, Tensor],
+        strides: Optional[Dict[int, float]] = None,
+        offsets: Optional[Dict[int, Tuple[int, int]]] = None,
+    ):
+        self.tables = {int(k): v.detach().float().view(1, 1, *v.shape[-2:]) for k, v in tables.items()}
+        self.strides = {int(k): float((strides or {}).get(int(k), 1.0)) for k in self.tables}
+        self.offsets = {int(k): tuple((offsets or {}).get(int(k), (0, 0))) for k in self.tables}
+        self._device_cache: Dict[int, Tensor] = {}
+
+    def __deepcopy__(self, memo):
+        return self
+
+    def sample(self, sensor_idxs: Tensor, rows: Tensor, cols: Tensor) -> Tensor:
+        """Readout time per ray. ``rows``/``cols`` are pixel-CENTRE coordinates (nerfstudio
+        adds the 0.5 offset) in the delivered, possibly cropped, image."""
+        out = torch.zeros_like(rows, dtype=torch.float32)
+        for sid in sensor_idxs.unique():
+            key = int(sid)
+            if key not in self.tables:
+                raise KeyError(f"No rolling-shutter lookup for sensor index {key}")
+            mask = (sensor_idxs == sid).squeeze(-1)
+            if not mask.any():
+                continue
+            cached = self._device_cache.get(key)
+            if cached is None or cached.device != rows.device:
+                cached = self.tables[key].to(rows.device)
+                self._device_cache[key] = cached
+            stride = self.strides[key]
+            off_x, off_y = self.offsets[key]
+            h_lut, w_lut = cached.shape[-2], cached.shape[-1]
+            # pixel centre -> integer canvas index -> table index
+            ty = (rows[mask] - 0.5 + off_y) / stride
+            tx = (cols[mask] - 0.5 + off_x) / stride
+            # align_corners=True: index i maps to -1 + 2*i/(n-1)
+            gy = ty * (2.0 / max(h_lut - 1, 1)) - 1.0
+            gx = tx * (2.0 / max(w_lut - 1, 1)) - 1.0
+            grid = torch.stack([gx.reshape(-1), gy.reshape(-1)], dim=-1).view(1, -1, 1, 2)
+            sampled = torch.nn.functional.grid_sample(
+                cached, grid, mode="bilinear", padding_mode="border", align_corners=True
+            ).view(-1, 1)
+            out[mask] = sampled.to(out.dtype)
+        return out
+
+
 @dataclass(init=False)
 class Cameras(TensorDataclass):
     """Dataparser outputs for the image dataset and the ray generator.
@@ -946,6 +1019,13 @@ class Cameras(TensorDataclass):
                 time_offsets = (cols / width - 0.5) * duration + self.metadata["time_to_center_pixel"][cam_idx]
                 if metadata["rs_direction"] == "Horizontal_reversed":
                     time_offsets = -time_offsets
+            elif isinstance(self.metadata.get("rs_time_offset_lookup"), RollingShutterLookup):
+                # Resampled images: per-pixel readout time from a lookup table, because
+                # after rectification the readout time is not linear in the output row.
