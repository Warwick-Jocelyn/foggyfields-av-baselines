#!/bin/bash
#SBATCH --job-name=nvfog_emernerf
#SBATCH --partition=test
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --gres=gpu:nvidia_rtx_pro_6000_blackwell_server_edition:1
#SBATCH --time=08:00:00
#SBATCH --output=/networkhome/WMGDS/wang3_y/ETH/NVIDIA-Fog-Output/_logs/emernerf_%j.log

# EmerNeRF (RGB+LiDAR) reproduction on NVIDIA_AV_Fog clip $SEQ.
# CONFIG = nvidia_av_fog (RGB-only) or nvidia_av_fog_lidar (RGB + depth supervision).

set -eo pipefail
source ~/miniconda3/etc/profile.d/conda.sh
conda activate splatad-blackwell
export PYTHONNOUSERSITE=1
: "${NVCC_PREPEND_FLAGS:=}"; export NVCC_PREPEND_FLAGS
export CUDA_HOME=$CONDA_PREFIX
export TORCH_CUDA_ARCH_LIST="12.0"
export CPATH=$CONDA_PREFIX/targets/x86_64-linux/include${CPATH:+:$CPATH}
export LIBRARY_PATH=$CONDA_PREFIX/targets/x86_64-linux/lib${LIBRARY_PATH:+:$LIBRARY_PATH}
export LD_LIBRARY_PATH=$CONDA_PREFIX/targets/x86_64-linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

SEQ="${SEQ:?must set SEQ=002|003|004 via --export=ALL,SEQ=...}"
CONFIG="${CONFIG:-nvidia_av_fog_lidar}"
NUM_ITERS="${NUM_ITERS:-25000}"
OUT_ROOT="/networkhome/WMGDS/wang3_y/ETH/NVIDIA-Fog-Output/emernerf/${SEQ}"
mkdir -p "$OUT_ROOT"

echo "[$(date)] node=$(hostname) seq=$SEQ method=emernerf iter=$NUM_ITERS config=$CONFIG"
nvidia-smi -L

cd ~/ETH/Code/EmerNeRF

echo "[$(date)] === STEP 1: train_emernerf.py ==="
python train_emernerf.py \
    --config_file "configs/${CONFIG}.yaml" \
    --output_root "$OUT_ROOT" \
    --project foggyfields_emernerf \
    --run_name "nvidia_fog_${SEQ}_7cam" \
    --enable_wandb \
    --entity haonan_zhao \
    data.scene_idx="${SEQ}" \
    data.start_timestep=0 \
    data.end_timestep=-1 \
    logging.saveckpt_freq="$NUM_ITERS" \
    optim.num_iters="$NUM_ITERS"

LOG_DIR=$(find "$OUT_ROOT" -type d -name "nvidia_fog_${SEQ}_7cam*" | sort | tail -1)
echo "[$(date)] log_dir=$LOG_DIR"

echo "[$(date)] DONE — videos auto-generated by EmerNeRF in $LOG_DIR/videos/"
ls -lh "$LOG_DIR"/videos/ 2>/dev/null | head -10
